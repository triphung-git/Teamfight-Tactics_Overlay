# =============================================================================
# CẤU HÌNH POSTMATCH TFT RIOT API
# =============================================================================

# 1. Riot API Key:
# Lấy tại: https://developer.riotgames.com (Lưu ý: Development Key hết hạn sau 24 giờ)
RIOT_API_KEY=RGAPI-4f10ccef-2aa0-427c-9ccd-21bf1016a5c6

# 2. Riot ID của người chơi cần tra cứu:
# Định dạng chuẩn: Tên#TAG (Ví dụ: "bí ẹo#0602", "Faker#KR1", "Doublelift#NA1")
RIOT_ID=bí ẹo#0602

# 3. Máy chủ / Khu vực tài khoản:
# Hỗ trợ: VN (hoặc VN2), KR, NA, EUW, EUNE, SG, TW, JP, BR, LAN, LAS, OCE
# Hệ thống sẽ tự động ánh xạ sang routing continental (sea, asia, americas, europe)
REGION=VN

# 4. Số trận đấu gần nhất cần lấy (Mặc định: 5)
MATCH_COUNT=2

# 5. Ngôn ngữ hiển thị tên Tướng, Trang bị, Hệ (vi_VN hoặc en_US)
LANGUAGE=vi_VN

# 6. Thư mục lưu kết quả xuất ra (CSV, JSON sạch, JSON thô)
OUTPUT_DIR=test1
