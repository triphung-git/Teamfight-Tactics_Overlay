# =============================================================================
# TFT POST-MATCH STUDIO — Cấu Hình Riot API
# Sao chép file này thành .env và điền thông tin của bạn
# =============================================================================

# 1. Riot API Key — Lấy tại: https://developer.riotgames.com
#    Development Key hết hạn sau 24 giờ. Production Key liên hệ Riot.
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# 2. Riot ID của người chơi cần tra cứu
#    Định dạng: TênIngame#TAG   (Ví dụ: Faker#KR1, Doublelift#NA1)
RIOT_ID=YourName#TAG

# 3. Khu vực tài khoản
#    Hỗ trợ: VN, KR, NA, EUW, EUNE, SG, TW, TH, PH, JP, BR, LAN, OCE
REGION=VN

# 4. Số trận đấu gần nhất cần lấy (1 - 20, mặc định: 5)
MATCH_COUNT=5

# 5. Ngôn ngữ hiển thị tên Tướng, Trang bị, Hệ trait
#    Hỗ trợ: vi_VN | en_US
LANGUAGE=vi_VN

# 6. Thư mục lưu kết quả (JSON cache)
OUTPUT_DIR=output
