# =============================================================================
# CẤU HÌNH POSTMATCH TFT RIOT API
# Điền API Key và Riot ID của bạn dưới đây rồi chạy: python main.py
# =============================================================================

# 1. Điền Riot API Key của bạn (bắt đầu bằng RGAPI-...)
RIOT_API_KEY=RGAPI-92908401-5796-4b43-be27-cb8bad6edbae


# 2. Điền Riot ID của bạn (Tên#TAG)
RIOT_ID=DC Slaydark#2603

# 3. Máy chủ (VN, KR, NA, EUW, SG, TW...)
REGION=VN

# 4. Số trận gần nhất cần lấy
MATCH_COUNT=1

# 5. Ngôn ngữ hiển thị (vi_VN hoặc en_US)
LANGUAGE=vi_VN

# 6. Thư mục lưu kết quả
OUTPUT_DIR=output
